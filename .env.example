# Which backend the app talks to.
#   mock     — in-memory demo data, no network, no credentials needed (default)
#   supabase — real auth, database, and Google Calendar sync
VITE_DATA_SOURCE=mock

# Required only when VITE_DATA_SOURCE=supabase.
# Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Calendar sync. Leave false until the Calendar API is enabled, the
# sync-schedule function is deployed, and you are a registered OAuth test user.
# With it off the app is still fully functional — the schedule persists to
# Postgres, there is simply no Calendar event. See README "Turning on Calendar
# sync".
VITE_ENABLE_CALENDAR_SYNC=false
