# Forces the in-memory provider, whatever .env.local says.
#
# Vite loads .env.[mode] after .env.local, so `npm run dev:mock` gets the
# offline demo without anyone editing the file that holds real credentials.
VITE_DATA_SOURCE=mock
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ENABLE_CALENDAR_SYNC=false
# Makes the demo user an admin, so /admin is reachable without a real role grant.
VITE_MOCK_ADMIN=true
